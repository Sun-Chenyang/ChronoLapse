<?xml version="1.0" encoding="utf-8"?>
<!-- ChronoLapse foreground art: clock ring with 10:10 hands and a record
     dot, drawn inside the adaptive icon safe zone (center ~66dp) -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- clock ring -->
    <path
        android:strokeColor="#FFB63B"
        android:strokeWidth="5.5"
        android:strokeLineCap="round"
        android:pathData="M28,54a26,26 0 1,0 52,0a26,26 0 1,0 -52,0" />

    <!-- minute hand, 2 o'clock -->
    <path
        android:strokeColor="#FFB63B"
        android:strokeWidth="5"
        android:strokeLineCap="round"
        android:pathData="M54,54L68.7,45.5" />

    <!-- hour hand, 10 o'clock -->
    <path
        android:strokeColor="#FFB63B"
        android:strokeWidth="5"
        android:strokeLineCap="round"
        android:pathData="M54,54L42.7,47.5" />

    <!-- record dot -->
    <path
        android:fillColor="#FF4D5E"
        android:pathData="M54,50.5a3.5,3.5 0 1,0 0.01,0Z" />
</vector>
